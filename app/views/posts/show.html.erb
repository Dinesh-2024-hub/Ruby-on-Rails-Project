<header>
  <h1>Post</h1>
</header>

<article class="post-card">

  <div>
    <strong>
      <%= link_to @post.user.display_name,
          user_profile_path(@post.user.username) %>
    </strong>

    <span>
      @<%= @post.user.username %>
    </span>

    <small>
      · <%= @post.created_at.strftime("%b %d, %Y %H:%M") %>
    </small>
  </div>

  <p>
    <%= @post.content %>
  </p>

  <div class="post-actions">

    <span>
      ❤️ <%= @post.likes.count %>
    </span>

    <span>
      💬 <%= @post.comments.count %>
    </span>

  </div>

  <div class="post-actions">

    <% like = @post.likes.find_by(user: Current.user) %>

    <% if like %>

      <%= button_to "Unlike",
          post_like_path(@post, like),
          method: :delete,
          class: "btn btn-secondary" %>

    <% else %>

      <%= button_to "Like",
          post_likes_path(@post),
          method: :post,
          class: "btn btn-secondary" %>

    <% end %>

    <% if @post.user == Current.user %>

      <%= link_to "Edit",
          edit_post_path(@post),
          class: "btn btn-secondary" %>

      <%= button_to "Delete",
          @post,
          method: :delete,
          class: "btn btn-secondary",
          data: {
            turbo_confirm: "Are you sure?"
          } %>

    <% end %>

  </div>

</article>

<section class="post-card">

  <h2>Comments</h2>

  <%= form_with model: [@post, Comment.new] do |form| %>

    <div class="form-group">

      <%= form.text_area :content,
          placeholder: "Write a reply..." %>

    </div>

    <%= form.submit "Reply",
        class: "btn btn-primary" %>

  <% end %>

</section>

<% @post.comments.order(created_at: :asc).each do |comment| %>

  <article class="post-card">

    <strong>
      <%= link_to comment.user.display_name,
          user_profile_path(comment.user.username) %>
    </strong>

    <span>
      @<%= comment.user.username %>
    </span>

    <p>
      <%= comment.content %>
    </p>

    <small>
      <%= comment.created_at.strftime("%b %d, %Y %H:%M") %>
    </small>

    <% if comment.user == Current.user %>

      <div class="post-actions">

        <%= button_to "Delete",
            post_comment_path(@post, comment),
            method: :delete,
            class: "btn btn-secondary",
            data: {
              turbo_confirm: "Delete this comment?"
            } %>

      </div>

    <% end %>

  </article>

<% end %>

<div style="padding: 25px;">
  <%= link_to "← Back to Home", home_path %>
</div>